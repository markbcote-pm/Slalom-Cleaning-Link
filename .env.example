# Copy to .env and fill in. Nothing is sent for real until DRY_RUN=0 and Twilio is set.
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data
TIMEZONE=America/Los_Angeles
PROPERTY_NAME=the rental

# Airbnb: Listing > Availability > Connect calendars > Export calendar
AIRBNB_ICAL_URL=
SYNC_MINUTES=30

# Times shown in messages and on the calendar
CHECKOUT_TIME=11:00
CHECKIN_TIME=13:00
# 0 = cleaner bills per stay; enter each amount on the dashboard
CLEANING_FEE=0

# Dashboard login (username is ignored, only the password is checked)
ADMIN_PASSWORD=change-me
# Secret part of the calendar feed URL: BASE_URL/feed/<FEED_TOKEN>.ics
FEED_TOKEN=change-me-to-something-long

# People. Approvers get approval requests; GROUP is everyone in the shared text.
# Format: Name:+15551234567:email@example.com  (email optional), comma separated
APPROVERS=Mark:+15550000001:mark@example.com,Danielle:+15550000002:
CLEANER=Cleaner:+15550000003

# Messaging
DRY_RUN=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550009999
# group: "conversation" = one real group text (Twilio Conversations group MMS, US/Canada)
#        "individual"   = same message texted to each person separately
GROUP_MODE=individual
TWILIO_CONVERSATION_SID=
# Optional email for approvals (Resend.com)
RESEND_API_KEY=
EMAIL_FROM=
